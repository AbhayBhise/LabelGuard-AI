# ============================================================
# LabelGuard AI — Environment Variables
# Copy to .env and fill in real values.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql://labelguard:labelguard@localhost:5432/labelguard

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object Storage (MinIO / S3) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=labelguard-media
MINIO_SECURE=false

# --- ML Worker URLs ---
OCR_WORKER_URL=http://localhost:8001
VLM_WORKER_URL=http://localhost:8002
LAYOUT_WORKER_URL=http://localhost:8003

# --- External VLM (fallback if not self-hosting) ---
GROQ_API_KEY=
TOGETHER_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
